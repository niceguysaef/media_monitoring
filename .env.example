BRAND24_API_KEY=your_brand24_api_key
BRAND24_ACCOUNT_ID=your_account_id
# Local development only. Omit this in App Platform to use same-origin /api routes.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional shared-password gate for a private client trial.
# Leave TRIAL_ACCESS_PASSWORD empty to disable the gate during local development.
TRIAL_ACCESS_PASSWORD=
TRIAL_SESSION_SECRET=replace_with_a_long_random_value
TRIAL_SESSION_HOURS=72
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Backend request and upstream-cost guardrails
RATE_LIMIT_DB_PATH=data/request_limits.sqlite3
UPSTREAM_TIMEOUT_SECONDS=10
UPSTREAM_MAX_CONCURRENCY=8
UPSTREAM_HOURLY_REQUEST_LIMIT=250
UPSTREAM_DAILY_REQUEST_LIMIT=1500

# Enable only when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false
